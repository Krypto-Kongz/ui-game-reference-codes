<!--
  DrawingBoard.xaml  -  Noesis page for DrawingBoardUI.ts (Meta Horizon Worlds)

  Everything themeable binds to the data context set by DrawingBoardUI.ts:
    theme.*  colors/shadow settings     pal.cN  theme palette        sel.* / sizeSel.*  selection flags
    ui.*     labels, toggles, flips     segs    ink segment pool     parts / ripples    particle pools
    cursor / prev / guides              commands (setTool, setColor, undo, onMove, ...)

  Only core Noesis features are used here (gradients, BlurEffect, DropShadowEffect, storyboards,
  behaviors). Optional shader brushes/effects live in ShaderFX.xaml and are pasted in at the
  marked SHADER-FX SLOT comments.
-->
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    x:Name="Page">

  <UserControl.Resources>

    <!-- ================================================================== -->
    <!-- Panels / layout helpers                                            -->
    <!-- ================================================================== -->

    <ItemsPanelTemplate x:Key="CanvasPanel">
      <Canvas/>
    </ItemsPanelTemplate>

    <ControlTemplate x:Key="BareContent" TargetType="ContentControl">
      <ContentPresenter/>
    </ControlTemplate>

    <!-- Theme-driven panel: neumorphic double shadow OR soft drop shadow, gradient face, glass sheen -->
    <Style x:Key="Panel" TargetType="ContentControl">
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <!-- neumorphism: dark shadow bottom-right -->
              <Border CornerRadius="26" Background="{Binding theme.panelSolid}" Visibility="{Binding theme.neoVis}">
                <Border.Effect>
                  <DropShadowEffect Color="{Binding theme.shadowDark}" Opacity="{Binding theme.shadowDarkOp}"
                                    BlurRadius="{Binding theme.shadowBlur}" ShadowDepth="{Binding theme.shadowDepth}" Direction="315"/>
                </Border.Effect>
              </Border>
              <!-- neumorphism: light shadow top-left -->
              <Border CornerRadius="26" Background="{Binding theme.panelSolid}" Visibility="{Binding theme.neoVis}">
                <Border.Effect>
                  <DropShadowEffect Color="{Binding theme.shadowLight}" Opacity="{Binding theme.shadowLightOp}"
                                    BlurRadius="{Binding theme.shadowBlur}" ShadowDepth="{Binding theme.shadowDepth}" Direction="135"/>
                </Border.Effect>
              </Border>
              <!-- glass / neon: one soft (or glowing) shadow -->
              <Border CornerRadius="26" Background="{Binding theme.panelSolid}" Visibility="{Binding theme.dropVis}">
                <Border.Effect>
                  <DropShadowEffect Color="{Binding theme.shadowDark}" Opacity="{Binding theme.shadowDarkOp}"
                                    BlurRadius="{Binding theme.shadowBlur}" ShadowDepth="{Binding theme.shadowDepth}" Direction="290"/>
                </Border.Effect>
              </Border>
              <!-- face -->
              <Border CornerRadius="26" BorderThickness="1.5">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{Binding theme.panelA}" Offset="0"/>
                    <GradientStop Color="{Binding theme.panelB}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{Binding theme.edgeA}" Offset="0"/>
                    <GradientStop Color="{Binding theme.edgeB}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <!-- glass sheen (top highlight) -->
              <Border CornerRadius="25" Margin="1.5" Opacity="{Binding theme.sheenOp}" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                    <GradientStop Color="#B3FFFFFF" Offset="0"/>
                    <GradientStop Color="#1AFFFFFF" Offset="0.38"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{Binding theme.subtext}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="4,8,0,6"/>
    </Style>

    <Style x:Key="Icon" TargetType="Path">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
    </Style>

    <Style x:Key="IconLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
    </Style>

    <!-- ================================================================== -->
    <!-- Buttons                                                            -->
    <!-- ================================================================== -->

    <!-- Squishy themed button. Tag = selected (bool). Cheap neo shadows (no blur) so 40+ buttons stay fast. -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Width" Value="60"/>
      <Setter Property="Height" Value="60"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Foreground" Value="{Binding theme.text}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <!-- selected glow -->
              <Border x:Name="Glow" CornerRadius="18" Margin="-4" Background="{Binding theme.glow}" Opacity="0.75" Visibility="Collapsed">
                <Border.Effect>
                  <BlurEffect Radius="14"/>
                </Border.Effect>
              </Border>
              <!-- neo shadows (offset rounded rects) -->
              <Border CornerRadius="17" Background="{Binding theme.shadowDark}" Opacity="0.45" Margin="3,3,-3,-3" Visibility="{Binding theme.neoVis}"/>
              <Border CornerRadius="17" Background="{Binding theme.shadowLight}" Opacity="0.9" Margin="-3,-3,3,3" Visibility="{Binding theme.neoVis}"/>
              <!-- face -->
              <Border x:Name="Face" CornerRadius="17" BorderThickness="1.2">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{Binding theme.btnA}" Offset="0"/>
                    <GradientStop Color="{Binding theme.btnB}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{Binding theme.edgeA}" Offset="0"/>
                    <GradientStop Color="{Binding theme.edgeB}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <!-- spinning selection ring -->
              <Border x:Name="Ring" CornerRadius="17" BorderThickness="2.2" Visibility="Collapsed">
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                      <RotateTransform x:Name="RingSpin" CenterX="0.5" CenterY="0.5"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="{Binding theme.accent}" Offset="0"/>
                    <GradientStop Color="{Binding theme.accent2}" Offset="0.5"/>
                    <GradientStop Color="{Binding theme.accent3}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <!-- press flash -->
              <Border x:Name="Flash" CornerRadius="17" Background="{Binding theme.accent}" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.09" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.09" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.08"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.08"/>
                      <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:0.45"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="4"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="4"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{Binding theme.accent}"/>
                <DataTrigger.EnterActions>
                  <BeginStoryboard x:Name="SpinRing">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="RingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2.4"/>
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.45" To="0.9" Duration="0:0:1.2" AutoReverse="True"/>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="SpinRing"/>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
      <Setter Property="Width" Value="68"/>
      <Setter Property="Height" Value="62"/>
      <Setter Property="Margin" Value="3,0"/>
    </Style>

    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="3"/>
    </Style>

    <!-- Pill toggle. Tag = on (bool). -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{Binding theme.text}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale"/>
              </Grid.RenderTransform>
              <Border x:Name="Bg" CornerRadius="16" Background="{Binding theme.chip}" BorderThickness="1" BorderBrush="{Binding theme.edgeB}"/>
              <Border x:Name="On" CornerRadius="16" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{Binding theme.chipOn}" Offset="0"/>
                    <GradientStop Color="{Binding theme.accent2}" Offset="1.6"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                  <DropShadowEffect Color="{Binding theme.chipOn}" ShadowDepth="0" BlurRadius="12" Opacity="0.6"/>
                </Border.Effect>
              </Border>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Scale" Property="ScaleX" Value="0.93"/>
                <Setter TargetName="Scale" Property="ScaleY" Value="0.93"/>
              </Trigger>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter Property="Foreground" Value="{Binding theme.chipOnText}"/>
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Color swatch: Background = color. Pops on hover. -->
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale"/>
              </Grid.RenderTransform>
              <Ellipse x:Name="Halo" Fill="{TemplateBinding Background}" Opacity="0" Margin="-5">
                <Ellipse.Effect>
                  <BlurEffect Radius="8"/>
                </Ellipse.Effect>
              </Ellipse>
              <Ellipse Fill="{TemplateBinding Background}" Stroke="{Binding theme.edgeA}" StrokeThickness="2"/>
              <Ellipse Margin="4,3,10,13" Opacity="0.45">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.25" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.25" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Scale" Property="ScaleX" Value="0.85"/>
                <Setter TargetName="Scale" Property="ScaleY" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Gallery card: Content = preview. -->
    <Style x:Key="Card" TargetType="Button">
      <Setter Property="Width" Value="150"/>
      <Setter Property="Height" Value="104"/>
      <Setter Property="Margin" Value="8"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale"/>
              </Grid.RenderTransform>
              <Border CornerRadius="18" Background="#33000000" Margin="2,6,2,-4">
                <Border.Effect><BlurEffect Radius="10"/></Border.Effect>
              </Border>
              <Border CornerRadius="18" ClipToBounds="True" BorderThickness="1.5" BorderBrush="#66FFFFFF">
                <ContentPresenter/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Invisible full-area button (gallery backdrop) -->
    <ControlTemplate x:Key="BareButton" TargetType="Button">
      <Border Background="{TemplateBinding Background}"/>
    </ControlTemplate>

    <!-- ================================================================== -->
    <!-- Ink templates. Brushes for animated kinds come from InkHost:       -->
    <!--   Foreground = rainbow, Background = liquid flow, BorderBrush = aurora -->
    <!-- ================================================================== -->

    <Style x:Key="InkLine" TargetType="Line">
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="Stroke" Value="{Binding c}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding k}" Value="rainbow">
          <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding k}" Value="flow">
          <Setter Property="Stroke" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding k}" Value="aurora">
          <Setter Property="Stroke" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GlowLine" TargetType="Line" BasedOn="{StaticResource InkLine}">
      <Setter Property="Stroke" Value="{Binding gc}"/>
    </Style>

    <DataTemplate x:Key="InkTpl">
      <Line X1="{Binding x1}" Y1="{Binding y1}" X2="{Binding x2}" Y2="{Binding y2}"
            StrokeThickness="{Binding w}" Opacity="{Binding o}" Visibility="{Binding vi}" Style="{StaticResource InkLine}"/>
    </DataTemplate>

    <DataTemplate x:Key="GlowTpl">
      <Line X1="{Binding x1}" Y1="{Binding y1}" X2="{Binding x2}" Y2="{Binding y2}"
            StrokeThickness="{Binding gw}" Opacity="{Binding o}" Visibility="{Binding vg}" Style="{StaticResource GlowLine}"/>
    </DataTemplate>

    <DataTemplate x:Key="PulseGlowTpl">
      <Line X1="{Binding x1}" Y1="{Binding y1}" X2="{Binding x2}" Y2="{Binding y2}"
            StrokeThickness="{Binding gw}" Opacity="{Binding o}" Visibility="{Binding vp}" Style="{StaticResource GlowLine}"/>
    </DataTemplate>

    <DataTemplate x:Key="PulseCoreTpl">
      <Line X1="{Binding x1}" Y1="{Binding y1}" X2="{Binding x2}" Y2="{Binding y2}" Stroke="#FFFFFFFF"
            StrokeThickness="{Binding w}" Opacity="{Binding o}" Visibility="{Binding vp}"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </DataTemplate>

    <!-- four-point star particle -->
    <DataTemplate x:Key="ParticleTpl">
      <Path Data="M0,-12 L2.8,-2.8 L12,0 L2.8,2.8 L0,12 L-2.8,2.8 L-12,0 L-2.8,-2.8 Z"
            Fill="{Binding c}" Opacity="{Binding o}" Visibility="{Binding v}">
        <Path.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding s}" ScaleY="{Binding s}"/>
            <RotateTransform Angle="{Binding r}"/>
          </TransformGroup>
        </Path.RenderTransform>
      </Path>
    </DataTemplate>

    <Style x:Key="ParticleItem" TargetType="ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding x}"/>
      <Setter Property="Canvas.Top" Value="{Binding y}"/>
    </Style>

    <DataTemplate x:Key="RippleTpl">
      <Ellipse Width="{Binding d}" Height="{Binding d}" Stroke="{Binding c}" StrokeThickness="3"
               Opacity="{Binding o}" Visibility="{Binding v}"/>
    </DataTemplate>

    <Style x:Key="RippleItem" TargetType="ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding l}"/>
      <Setter Property="Canvas.Top" Value="{Binding t}"/>
    </Style>

    <!-- ================================================================== -->
    <!-- Storyboards                                                        -->
    <!-- ================================================================== -->

    <Storyboard x:Key="Ambient">
      <!-- drifting background blobs -->
      <DoubleAnimation Storyboard.TargetName="BlobAT" Storyboard.TargetProperty="X" From="-120" To="220" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="BlobAT" Storyboard.TargetProperty="Y" From="-80" To="160" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="BlobBT" Storyboard.TargetProperty="X" From="160" To="-260" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="BlobBT" Storyboard.TargetProperty="Y" From="120" To="-160" Duration="0:0:10" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="BlobCT" Storyboard.TargetProperty="X" From="-240" To="240" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="BlobCS" Storyboard.TargetProperty="ScaleX" From="0.85" To="1.25" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="BlobCS" Storyboard.TargetProperty="ScaleY" From="0.85" To="1.25" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever"/>

      <!-- animated ink brushes -->
      <DoubleAnimation Storyboard.TargetName="RainbowShift" Storyboard.TargetProperty="X" From="0" To="720" Duration="0:0:3.2" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="FlowShift" Storyboard.TargetProperty="X" From="0" To="520" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="FlowShift" Storyboard.TargetProperty="Y" From="0" To="180" Duration="0:0:2.7" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="AuroraSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:9" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="AuroraWave" Storyboard.TargetProperty="Y" From="0" To="600" Duration="0:0:4" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="PulseGroup" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>

      <!-- chrome -->
      <DoubleAnimation Storyboard.TargetName="TitleShift" Storyboard.TargetProperty="X" From="-300" To="300" Duration="0:0:3.5" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="LogoSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="ColorRingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:5" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="ColorGlow" Storyboard.TargetProperty="Opacity" From="0.4" To="0.95" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="OrbFloat" Storyboard.TargetProperty="Y" From="-6" To="6" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="OrbSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="CursorSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="FloorGlow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Hint" Storyboard.TargetProperty="Opacity" From="0.35" To="0.85" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>

      <!-- marching ants: shape preview + mirror guides -->
      <DoubleAnimation Storyboard.TargetName="PrevLine" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-12" Duration="0:0:0.5" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="PrevRect" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-12" Duration="0:0:0.5" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="PrevEll" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-12" Duration="0:0:0.5" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="GuideV" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-24" Duration="0:0:1.2" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="GuideH" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-24" Duration="0:0:1.2" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="GuideD1" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-24" Duration="0:0:1.2" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="GuideD2" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-24" Duration="0:0:1.2" RepeatBehavior="Forever"/>

      <!-- CRT scanlines crawl + rolling bright band -->
      <DoubleAnimation Storyboard.TargetName="ScanShift" Storyboard.TargetProperty="Y" From="0" To="4" Duration="0:0:0.35" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="ScanBandT" Storyboard.TargetProperty="Y" From="-300" To="1400" Duration="0:0:6.5" RepeatBehavior="Forever"/>
    </Storyboard>

    <Storyboard x:Key="Intro">
      <DoubleAnimation Storyboard.TargetName="TopBarT" Storyboard.TargetProperty="Y" From="-160" To="0" Duration="0:0:0.8">
        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="LeftBarT" Storyboard.TargetProperty="X" From="-260" To="0" BeginTime="0:0:0.15" Duration="0:0:0.8">
        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="RightBarT" Storyboard.TargetProperty="X" From="340" To="0" BeginTime="0:0:0.25" Duration="0:0:0.8">
        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="DockT" Storyboard.TargetProperty="Y" From="200" To="0" BeginTime="0:0:0.35" Duration="0:0:0.8">
        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Panels" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
    </Storyboard>

  </UserControl.Resources>

  <UserControl.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource Ambient}"/>
      <BeginStoryboard Storyboard="{StaticResource Intro}"/>
    </EventTrigger>
  </UserControl.Triggers>

  <Grid x:Name="Root" ClipToBounds="True">

    <!-- ================================================================== -->
    <!-- 1. Background gradient + drifting blobs                            -->
    <!-- ================================================================== -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="{Binding theme.bgA}" Offset="0"/>
          <GradientStop Color="{Binding theme.bgB}" Offset="0.55"/>
          <GradientStop Color="{Binding theme.bgC}" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid IsHitTestVisible="False" Opacity="{Binding theme.blobOp}">
      <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-200,0,0">
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobAT"/></Ellipse.RenderTransform>
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="{Binding theme.blobA}" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-260">
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobBT"/></Ellipse.RenderTransform>
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="{Binding theme.blobB}" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="640" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="BlobCS"/>
            <TranslateTransform x:Name="BlobCT"/>
          </TransformGroup>
        </Ellipse.RenderTransform>
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="{Binding theme.blobC}" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <!-- SHADER-FX SLOT A: animated shader backgrounds (PlasmaBrushShader / WavesBrushShader) go here -->
    </Grid>

    <!-- ================================================================== -->
    <!-- 2. Drawing canvas (full bleed; panels float above it)              -->
    <!-- SHADER-FX SLOT B: wrap CanvasHost in the effect Grids (see add-on) -->
    <!-- ================================================================== -->
    <Grid x:Name="CanvasHost">
      <Grid.RenderTransform>
        <TranslateTransform/>
      </Grid.RenderTransform>
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ui.shakeFlip}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                      <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-14"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="12"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="-9"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.20" Value="6"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="-3"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                      <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="12"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="-10"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="7"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.20" Value="-4"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="2"/>
                      <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <!-- paper -->
      <Rectangle Fill="{Binding theme.canvas}" IsHitTestVisible="False"/>

      <!-- grid overlay -->
      <Grid Opacity="{Binding ui.gridOp}" IsHitTestVisible="False">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="40,0" SpreadMethod="Repeat">
              <GradientStop Color="{Binding theme.gridC}" Offset="0"/>
              <GradientStop Color="{Binding theme.gridC}" Offset="0.04"/>
              <GradientStop Color="#00000000" Offset="0.04"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,40" SpreadMethod="Repeat">
              <GradientStop Color="{Binding theme.gridC}" Offset="0"/>
              <GradientStop Color="{Binding theme.gridC}" Offset="0.04"/>
              <GradientStop Color="#00000000" Offset="0.04"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <!-- physics floor -->
      <Canvas IsHitTestVisible="False">
        <Rectangle x:Name="FloorGlow" Canvas.Left="{Binding ui.floorX}" Canvas.Top="{Binding ui.floorY}" Width="{Binding ui.floorW}" Height="3" Margin="0,-1,0,0">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFFFFF" Offset="0"/>
              <GradientStop Color="{Binding theme.floorC}" Offset="0.2"/>
              <GradientStop Color="{Binding theme.floorC}" Offset="0.8"/>
              <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
          <Rectangle.Effect>
            <DropShadowEffect Color="{Binding theme.floorC}" ShadowDepth="0" BlurRadius="14" Opacity="1"/>
          </Rectangle.Effect>
        </Rectangle>
      </Canvas>

      <!-- mirror / kaleidoscope guides -->
      <Canvas IsHitTestVisible="False" Opacity="0.5">
        <Line x:Name="GuideV" X1="{Binding guides.cx}" X2="{Binding guides.cx}" Y1="0" Y2="{Binding guides.H}"
              Stroke="{Binding theme.accent}" StrokeThickness="1.5" StrokeDashArray="6 6" Visibility="{Binding guides.vV}"/>
        <Line x:Name="GuideH" Y1="{Binding guides.cy}" Y2="{Binding guides.cy}" X1="0" X2="{Binding guides.W}"
              Stroke="{Binding theme.accent2}" StrokeThickness="1.5" StrokeDashArray="6 6" Visibility="{Binding guides.hV}"/>
        <Line x:Name="GuideD1" X1="{Binding guides.d1x1}" Y1="{Binding guides.d1y1}" X2="{Binding guides.d1x2}" Y2="{Binding guides.d1y2}"
              Stroke="{Binding theme.accent3}" StrokeThickness="1.2" StrokeDashArray="4 8" Visibility="{Binding guides.dV}"/>
        <Line x:Name="GuideD2" X1="{Binding guides.d2x1}" Y1="{Binding guides.d2y1}" X2="{Binding guides.d2x2}" Y2="{Binding guides.d2y2}"
              Stroke="{Binding theme.accent3}" StrokeThickness="1.2" StrokeDashArray="4 8" Visibility="{Binding guides.dV}"/>
      </Canvas>

      <!-- INK. InkHost exposes three animated brushes to the line templates. -->
      <ContentControl x:Name="InkHost" Template="{StaticResource BareContent}" IsHitTestVisible="False">
        <ContentControl.Foreground>
          <!-- rainbow, flows diagonally across the whole canvas -->
          <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="720,240" SpreadMethod="Repeat">
            <LinearGradientBrush.Transform>
              <TranslateTransform x:Name="RainbowShift"/>
            </LinearGradientBrush.Transform>
            <GradientStop Color="#FFFF3B3B" Offset="0"/>
            <GradientStop Color="#FFFF9F1C" Offset="0.16"/>
            <GradientStop Color="#FFFFE53B" Offset="0.33"/>
            <GradientStop Color="#FF3BFF7A" Offset="0.5"/>
            <GradientStop Color="#FF3BC8FF" Offset="0.66"/>
            <GradientStop Color="#FF8C5BFF" Offset="0.83"/>
            <GradientStop Color="#FFFF3B3B" Offset="1"/>
          </LinearGradientBrush>
        </ContentControl.Foreground>
        <ContentControl.Background>
          <!-- liquid flow, theme accents with a travelling white highlight -->
          <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="260,90" SpreadMethod="Reflect">
            <LinearGradientBrush.Transform>
              <TranslateTransform x:Name="FlowShift"/>
            </LinearGradientBrush.Transform>
            <GradientStop Color="{Binding theme.accent}" Offset="0"/>
            <GradientStop Color="{Binding theme.accent2}" Offset="0.45"/>
            <GradientStop Color="#FFFFFFFF" Offset="0.55"/>
            <GradientStop Color="{Binding theme.accent3}" Offset="1"/>
          </LinearGradientBrush>
        </ContentControl.Background>
        <ContentControl.BorderBrush>
          <!-- aurora curtains: green / cyan / violet bands that sway and rotate -->
          <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,300" SpreadMethod="Reflect">
            <LinearGradientBrush.Transform>
              <TransformGroup>
                <TranslateTransform x:Name="AuroraWave"/>
                <RotateTransform x:Name="AuroraSpin" CenterX="800" CenterY="450"/>
              </TransformGroup>
            </LinearGradientBrush.Transform>
            <GradientStop Color="#FF00FFA3" Offset="0"/>
            <GradientStop Color="#FF00D1FF" Offset="0.35"/>
            <GradientStop Color="#FF7B61FF" Offset="0.7"/>
            <GradientStop Color="#FFFF5CA8" Offset="1"/>
          </LinearGradientBrush>
        </ContentControl.BorderBrush>

        <Grid>
          <!-- bloom layer: one blur pass for every glowing stroke -->
          <ItemsControl ItemsSource="{Binding segs}" ItemTemplate="{StaticResource GlowTpl}" ItemsPanel="{StaticResource CanvasPanel}">
            <ItemsControl.Effect>
              <BlurEffect Radius="{Binding ui.bloom}"/>
            </ItemsControl.Effect>
          </ItemsControl>
          <!-- crisp ink -->
          <ItemsControl ItemsSource="{Binding segs}" ItemTemplate="{StaticResource InkTpl}" ItemsPanel="{StaticResource CanvasPanel}"/>
          <!-- pulse: breathing glow + hot core -->
          <Grid x:Name="PulseGroup">
            <ItemsControl ItemsSource="{Binding segs}" ItemTemplate="{StaticResource PulseGlowTpl}" ItemsPanel="{StaticResource CanvasPanel}">
              <ItemsControl.Effect>
                <BlurEffect Radius="12"/>
              </ItemsControl.Effect>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding segs}" ItemTemplate="{StaticResource PulseCoreTpl}" ItemsPanel="{StaticResource CanvasPanel}"/>
          </Grid>
        </Grid>
      </ContentControl>

      <!-- shape preview (marching ants) -->
      <Canvas IsHitTestVisible="False">
        <Line x:Name="PrevLine" X1="{Binding prev.x1}" Y1="{Binding prev.y1}" X2="{Binding prev.x2}" Y2="{Binding prev.y2}"
              Stroke="{Binding prev.c}" StrokeThickness="2" StrokeDashArray="4 2" Visibility="{Binding prev.lineV}"/>
        <Rectangle x:Name="PrevRect" Canvas.Left="{Binding prev.l}" Canvas.Top="{Binding prev.t}" Width="{Binding prev.w}" Height="{Binding prev.h}"
                   Stroke="{Binding prev.c}" StrokeThickness="2" StrokeDashArray="4 2" Visibility="{Binding prev.rectV}"/>
        <Ellipse x:Name="PrevEll" Canvas.Left="{Binding prev.l}" Canvas.Top="{Binding prev.t}" Width="{Binding prev.w}" Height="{Binding prev.h}"
                 Stroke="{Binding prev.c}" StrokeThickness="2" StrokeDashArray="4 2" Visibility="{Binding prev.ellV}"/>
      </Canvas>

      <!-- particles + click ripples -->
      <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding ripples}" ItemTemplate="{StaticResource RippleTpl}"
                    ItemsPanel="{StaticResource CanvasPanel}" ItemContainerStyle="{StaticResource RippleItem}"/>
      <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding parts}" ItemTemplate="{StaticResource ParticleTpl}"
                    ItemsPanel="{StaticResource CanvasPanel}" ItemContainerStyle="{StaticResource ParticleItem}">
        <ItemsControl.Effect>
          <DropShadowEffect Color="#FFFFFFFF" ShadowDepth="0" BlurRadius="10" Opacity="0.8"/>
        </ItemsControl.Effect>
      </ItemsControl>

      <!-- brush cursor -->
      <Canvas IsHitTestVisible="False">
        <Grid Canvas.Left="{Binding cursor.l}" Canvas.Top="{Binding cursor.t}" Width="{Binding cursor.d}" Height="{Binding cursor.d}"
              Visibility="{Binding cursor.v}">
          <Ellipse Stroke="{Binding cursor.c}" StrokeThickness="1.5" Opacity="0.9"/>
          <Ellipse Margin="-6" Stroke="{Binding cursor.c}" StrokeThickness="1.2" StrokeDashArray="2 3" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="CursorSpin"/>
            </Ellipse.RenderTransform>
          </Ellipse>
        </Grid>
      </Canvas>

      <!-- empty-canvas hint -->
      <TextBlock x:Name="Hint" Text="Draw anywhere. Try the Physics Pen, then hit Gravity." Visibility="{Binding ui.hintVis}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Light"
                 Foreground="{Binding theme.subtext}" IsHitTestVisible="False"/>

      <!-- INPUT PAD: receives pointer / touch for the whole canvas -->
      <Rectangle x:Name="HitPad" Fill="Transparent">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseMove">
            <b:InvokeCommandAction Command="{Binding onMove}" PassEventArgsToCommand="True"/>
          </b:EventTrigger>
          <b:EventTrigger EventName="MouseLeftButtonDown">
            <b:InvokeCommandAction Command="{Binding onDown}" PassEventArgsToCommand="True"/>
          </b:EventTrigger>
          <b:EventTrigger EventName="MouseLeftButtonUp">
            <b:InvokeCommandAction Command="{Binding onUp}" PassEventArgsToCommand="True"/>
          </b:EventTrigger>
          <b:EventTrigger EventName="MouseLeave">
            <b:InvokeCommandAction Command="{Binding onLeave}"/>
          </b:EventTrigger>
          <b:EventTrigger EventName="TouchDown">
            <b:InvokeCommandAction Command="{Binding onDown}" PassEventArgsToCommand="True"/>
          </b:EventTrigger>
          <b:EventTrigger EventName="TouchMove">
            <b:InvokeCommandAction Command="{Binding onMove}" PassEventArgsToCommand="True"/>
          </b:EventTrigger>
          <b:EventTrigger EventName="TouchUp">
            <b:InvokeCommandAction Command="{Binding onUp}" PassEventArgsToCommand="True"/>
          </b:EventTrigger>
          <b:EventTrigger EventName="SizeChanged">
            <b:InvokeCommandAction Command="{Binding onSize}" PassEventArgsToCommand="True"/>
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </Rectangle>
    </Grid>

    <!-- ================================================================== -->
    <!-- 3. Screen FX (non-interactive)                                     -->
    <!-- ================================================================== -->
    <Grid IsHitTestVisible="False">
      <!-- vignette -->
      <Rectangle Opacity="{Binding ui.vigOp}">
        <Rectangle.Fill>
          <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#00000000" Offset="0.5"/>
            <GradientStop Color="{Binding theme.vignette}" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- CRT scanlines -->
      <Rectangle Opacity="{Binding ui.crtOp}">
        <Rectangle.Fill>
          <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,4" SpreadMethod="Repeat">
            <LinearGradientBrush.Transform>
              <TranslateTransform x:Name="ScanShift"/>
            </LinearGradientBrush.Transform>
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="0.5"/>
            <GradientStop Color="#FF000000" Offset="0.5"/>
            <GradientStop Color="#FF000000" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle Height="220" VerticalAlignment="Top" Opacity="{Binding ui.crtOp}">
        <Rectangle.RenderTransform>
          <TranslateTransform x:Name="ScanBandT"/>
        </Rectangle.RenderTransform>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#55FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <!-- theme-change ripple -->
      <Ellipse Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <ScaleTransform ScaleX="0" ScaleY="0"/>
        </Ellipse.RenderTransform>
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
            <GradientStop Color="{Binding theme.accent}" Offset="0.85"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ui.themeFlip}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.1"/>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.2" To="12" Duration="0:0:1.1">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.2" To="12" Duration="0:0:1.1">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.1"/>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.2" To="12" Duration="0:0:1.1">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.2" To="12" Duration="0:0:1.1">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
    </Grid>

    <!-- ================================================================== -->
    <!-- 4. Floating panels                                                 -->
    <!-- ================================================================== -->
    <Grid x:Name="Panels" Visibility="{Binding ui.panelsVis}">

      <!-- ~~~~ Top bar ~~~~ -->
      <ContentControl Style="{StaticResource Panel}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="14,8">
        <ContentControl.RenderTransform>
          <TranslateTransform x:Name="TopBarT"/>
        </ContentControl.RenderTransform>
        <StackPanel Orientation="Horizontal">
          <!-- logo orb -->
          <Grid Width="44" Height="44" VerticalAlignment="Center">
            <Ellipse Margin="-6" Opacity="0.7">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="{Binding theme.glow}" Offset="0"/>
                  <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse>
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <LinearGradientBrush.RelativeTransform>
                    <RotateTransform x:Name="LogoSpin" CenterX="0.5" CenterY="0.5"/>
                  </LinearGradientBrush.RelativeTransform>
                  <GradientStop Color="{Binding theme.accent}" Offset="0"/>
                  <GradientStop Color="{Binding theme.accent2}" Offset="0.5"/>
                  <GradientStop Color="{Binding theme.accent3}" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Path Data="M14,30 C18,18 24,30 30,14" Stroke="#FFFFFFFF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Grid>

          <StackPanel Margin="12,0,18,0" VerticalAlignment="Center">
            <TextBlock Text="DREAM CANVAS" FontSize="22" FontWeight="Black">
              <TextBlock.Foreground>
                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="180,0" SpreadMethod="Reflect">
                  <LinearGradientBrush.Transform>
                    <TranslateTransform x:Name="TitleShift"/>
                  </LinearGradientBrush.Transform>
                  <GradientStop Color="{Binding theme.text}" Offset="0"/>
                  <GradientStop Color="{Binding theme.accent}" Offset="0.45"/>
                  <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                  <GradientStop Color="{Binding theme.accent2}" Offset="0.55"/>
                  <GradientStop Color="{Binding theme.text}" Offset="1"/>
                </LinearGradientBrush>
              </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="{Binding ui.themeStyle}" FontSize="11" Foreground="{Binding theme.subtext}"/>
          </StackPanel>

          <!-- theme switcher -->
          <Button Style="{StaticResource SmallBtn}" Command="{Binding prevTheme}" VerticalAlignment="Center">
            <Path Style="{StaticResource Icon}" Data="M15,5 L8,12 L15,19"/>
          </Button>
          <Button Style="{StaticResource Chip}" Command="{Binding toggleGallery}" Tag="{Binding ui.galleryOpen}" Height="40" MinWidth="170" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{Binding ui.themeName}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding ui.themeIndexLabel}" FontSize="9" Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SmallBtn}" Command="{Binding nextTheme}" VerticalAlignment="Center">
            <Path Style="{StaticResource Icon}" Data="M9,5 L16,12 L9,19"/>
          </Button>
          <Button Style="{StaticResource SmallBtn}" Command="{Binding toggleGallery}" VerticalAlignment="Center">
            <Path Style="{StaticResource Icon}" Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z"/>
          </Button>

          <Rectangle Width="1.5" Margin="12,6" Fill="{Binding theme.edgeB}"/>

          <!-- status chips -->
          <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="{Binding ui.toolName}" FontSize="13" FontWeight="Bold" Foreground="{Binding theme.text}"/>
            <TextBlock Text="{Binding ui.sizeLabel}" FontSize="10" Foreground="{Binding theme.subtext}"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Margin="8,0">
            <TextBlock Text="{Binding ui.inkCount}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding theme.text}"/>
            <TextBlock Text="{Binding ui.bodyCount}" FontSize="10" Foreground="{Binding theme.subtext}"/>
          </StackPanel>
          <TextBlock Text="{Binding ui.worldStatus}" FontSize="11" VerticalAlignment="Center" Margin="8,0" Foreground="{Binding theme.subtext}"/>

          <Button Style="{StaticResource SmallBtn}" Command="{Binding toggleMinimize}" VerticalAlignment="Center">
            <Path Style="{StaticResource Icon}" Data="M5,12 L19,12"/>
          </Button>
        </StackPanel>
      </ContentControl>

      <!-- ~~~~ Left: tools ~~~~ -->
      <ContentControl Style="{StaticResource Panel}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,60,0,60" Padding="8,10">
