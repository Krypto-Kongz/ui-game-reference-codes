            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="ellipse" Tag="{Binding sel.ellipse}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M12,5 A8,7 0 1 1 11.99,5"/><TextBlock Style="{StaticResource IconLabel}" Text="Ellipse"/></StackPanel>
