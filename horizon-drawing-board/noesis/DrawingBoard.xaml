              </Button>
              <Button Style="{StaticResource Card}" Command="{Binding setTheme}" CommandParameter="4">
                <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#05010F" Offset="0"/><GradientStop Color="#120326" Offset="1"/></LinearGradientBrush></Grid.Background>
                  <Border Width="70" Height="34" CornerRadius="12" BorderBrush="#00F0FF" BorderThickness="2" Margin="0,0,0,26"><Border.Effect><DropShadowEffect Color="#FF00E5" ShadowDepth="0" BlurRadius="14"/></Border.Effect></Border>
                  <TextBlock Text="Neon Cyberpunk" VerticalAlignment="Bottom" Margin="10,0,0,8" FontWeight="Bold" Foreground="#00F0FF"/></Grid>
              </Button>
              <Button Style="{StaticResource Card}" Command="{Binding setTheme}" CommandParameter="5">
                <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2D0B59" Offset="0"/><GradientStop Color="#B6339E" Offset="0.6"/><GradientStop Color="#FF9A8B" Offset="1"/></LinearGradientBrush></Grid.Background>
                  <Ellipse Width="44" Height="44" Margin="0,0,0,24"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF27A" Offset="0"/><GradientStop Color="#FF6AD5" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  <TextBlock Text="Vaporwave" VerticalAlignment="Bottom" Margin="10,0,0,8" FontWeight="Bold" Foreground="#FFF3FD"/></Grid>
