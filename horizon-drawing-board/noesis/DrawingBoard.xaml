          </StackPanel>
        </ContentControl>
      </Grid>
    </Grid>

    <!-- ================================================================== -->
    <!-- 5. Minimized orb (restores the panels)                             -->
    <!-- ================================================================== -->
    <Button Visibility="{Binding ui.orbVis}" Command="{Binding toggleMinimize}" Width="72" Height="72"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Template="{StaticResource BareButton}" Background="Transparent">
      <Button.RenderTransform>
        <TranslateTransform x:Name="OrbFloat"/>
      </Button.RenderTransform>
      <Grid>
        <Ellipse Margin="-10" Fill="{Binding theme.glow}" Opacity="0.7">
          <Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse>
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <LinearGradientBrush.RelativeTransform>
                <RotateTransform x:Name="OrbSpin" CenterX="0.5" CenterY="0.5"/>
              </LinearGradientBrush.RelativeTransform>
              <GradientStop Color="{Binding theme.accent}" Offset="0"/>
              <GradientStop Color="{Binding theme.accent2}" Offset="0.5"/>
              <GradientStop Color="{Binding theme.accent3}" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Path Data="M22,46 C28,28 38,46 50,24" Stroke="#FFFFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Button>
  </Grid>
</UserControl>
