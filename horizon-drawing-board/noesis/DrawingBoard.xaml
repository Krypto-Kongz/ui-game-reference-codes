                  <Border Width="70" Height="34" CornerRadius="12" Background="#59075080" BorderBrush="#9900C9FF" BorderThickness="1" Margin="0,0,0,26"/>
                  <TextBlock Text="Ocean Deep" VerticalAlignment="Bottom" Margin="10,0,0,8" FontWeight="Bold" Foreground="#E0F7FF"/></Grid>
              </Button>
              <Button Style="{StaticResource Card}" Command="{Binding setTheme}" CommandParameter="8">
                <Grid><Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#020B1A" Offset="0"/><GradientStop Color="#00FFA3" Offset="0.6"/><GradientStop Color="#7B61FF" Offset="1"/></LinearGradientBrush></Grid.Background>
