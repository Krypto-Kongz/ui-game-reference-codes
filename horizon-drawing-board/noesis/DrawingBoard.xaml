      </ContentControl>

      <!-- ~~~~ Right: color, size, effects ~~~~ -->
      <ContentControl Style="{StaticResource Panel}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,60,16,60" Width="268" Padding="14,12">
        <ContentControl.RenderTransform>
          <TranslateTransform x:Name="RightBarT"/>
        </ContentControl.RenderTransform>
        <StackPanel>
          <!-- current color: glowing orb with spinning ring -->
          <Grid Height="86">
            <Grid Width="70" Height="70" HorizontalAlignment="Left" Margin="6,0,0,0">
              <Ellipse x:Name="ColorGlow" Fill="{Binding ui.colorGlow}" Margin="-10">
                <Ellipse.Effect><BlurEffect Radius="18"/></Ellipse.Effect>
              </Ellipse>
              <!-- SHADER-FX SLOT D: optional conic rainbow ring replaces this Ellipse -->
              <Ellipse StrokeThickness="3">
                <Ellipse.Stroke>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                      <RotateTransform x:Name="ColorRingSpin" CenterX="0.5" CenterY="0.5"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#FFFFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Stroke>
              </Ellipse>
              <Ellipse Margin="6" Fill="{Binding ui.color}"/>
              <Ellipse Margin="12,9,26,33" Opacity="0.5">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <StackPanel Margin="92,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding ui.toolName}" FontSize="16" FontWeight="Bold" Foreground="{Binding theme.text}"/>
              <TextBlock Text="{Binding ui.color}" FontSize="12" Foreground="{Binding theme.subtext}"/>
              <TextBlock Text="{Binding ui.mirrorLabel}" FontSize="11" Foreground="{Binding theme.subtext}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="THEME PALETTE" Style="{StaticResource Header}"/>
          <UniformGrid Columns="6">
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c0}" Command="{Binding setColor}" CommandParameter="p0"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c1}" Command="{Binding setColor}" CommandParameter="p1"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c2}" Command="{Binding setColor}" CommandParameter="p2"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c3}" Command="{Binding setColor}" CommandParameter="p3"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c4}" Command="{Binding setColor}" CommandParameter="p4"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c5}" Command="{Binding setColor}" CommandParameter="p5"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c6}" Command="{Binding setColor}" CommandParameter="p6"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c7}" Command="{Binding setColor}" CommandParameter="p7"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c8}" Command="{Binding setColor}" CommandParameter="p8"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c9}" Command="{Binding setColor}" CommandParameter="p9"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c10}" Command="{Binding setColor}" CommandParameter="p10"/>
            <Button Style="{StaticResource Swatch}" Background="{Binding pal.c11}" Command="{Binding setColor}" CommandParameter="p11"/>
          </UniformGrid>

          <TextBlock Text="SPECTRUM" Style="{StaticResource Header}"/>
          <UniformGrid Columns="6">
            <Button Style="{StaticResource Swatch}" Background="#FF3B3B" Command="{Binding setColor}" CommandParameter="#FF3B3B"/>
            <Button Style="{StaticResource Swatch}" Background="#FF8A1C" Command="{Binding setColor}" CommandParameter="#FF8A1C"/>
            <Button Style="{StaticResource Swatch}" Background="#FFD23B" Command="{Binding setColor}" CommandParameter="#FFD23B"/>
            <Button Style="{StaticResource Swatch}" Background="#B6FF3B" Command="{Binding setColor}" CommandParameter="#B6FF3B"/>
            <Button Style="{StaticResource Swatch}" Background="#3BFF7A" Command="{Binding setColor}" CommandParameter="#3BFF7A"/>
            <Button Style="{StaticResource Swatch}" Background="#3BFFE0" Command="{Binding setColor}" CommandParameter="#3BFFE0"/>
            <Button Style="{StaticResource Swatch}" Background="#3BB0FF" Command="{Binding setColor}" CommandParameter="#3BB0FF"/>
            <Button Style="{StaticResource Swatch}" Background="#4B5BFF" Command="{Binding setColor}" CommandParameter="#4B5BFF"/>
            <Button Style="{StaticResource Swatch}" Background="#9B4BFF" Command="{Binding setColor}" CommandParameter="#9B4BFF"/>
            <Button Style="{StaticResource Swatch}" Background="#FF4BE1" Command="{Binding setColor}" CommandParameter="#FF4BE1"/>
            <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Command="{Binding setColor}" CommandParameter="#FFFFFF"/>
            <Button Style="{StaticResource Swatch}" Background="#14141A" Command="{Binding setColor}" CommandParameter="#14141A"/>
          </UniformGrid>

          <TextBlock Text="BRUSH SIZE" Style="{StaticResource Header}"/>
          <UniformGrid Columns="6">
            <Button Style="{StaticResource SmallBtn}" Command="{Binding setSize}" CommandParameter="2" Tag="{Binding sizeSel.s2}"><Ellipse Width="3" Height="3" Fill="{Binding ui.color}"/></Button>
            <Button Style="{StaticResource SmallBtn}" Command="{Binding setSize}" CommandParameter="4" Tag="{Binding sizeSel.s4}"><Ellipse Width="5" Height="5" Fill="{Binding ui.color}"/></Button>
            <Button Style="{StaticResource SmallBtn}" Command="{Binding setSize}" CommandParameter="8" Tag="{Binding sizeSel.s8}"><Ellipse Width="8" Height="8" Fill="{Binding ui.color}"/></Button>
            <Button Style="{StaticResource SmallBtn}" Command="{Binding setSize}" CommandParameter="14" Tag="{Binding sizeSel.s14}"><Ellipse Width="12" Height="12" Fill="{Binding ui.color}"/></Button>
            <Button Style="{StaticResource SmallBtn}" Command="{Binding setSize}" CommandParameter="24" Tag="{Binding sizeSel.s24}"><Ellipse Width="17" Height="17" Fill="{Binding ui.color}"/></Button>
            <Button Style="{StaticResource SmallBtn}" Command="{Binding setSize}" CommandParameter="40" Tag="{Binding sizeSel.s40}"><Ellipse Width="23" Height="23" Fill="{Binding ui.color}"/></Button>
          </UniformGrid>

          <TextBlock Text="EFFECTS" Style="{StaticResource Header}"/>
          <WrapPanel>
            <Button Style="{StaticResource Chip}" Content="Glow" Command="{Binding toggleGlow}" Tag="{Binding ui.glowOn}"/>
            <Button Style="{StaticResource Chip}" Content="Stardust" Command="{Binding toggleSparkle}" Tag="{Binding ui.sparkleOn}"/>
            <Button Style="{StaticResource Chip}" Content="{Binding ui.mirrorLabel}" Command="{Binding cycleMirror}" Tag="{Binding ui.mirrorOn}"/>
            <Button Style="{StaticResource Chip}" Content="Grid" Command="{Binding toggleGrid}" Tag="{Binding ui.gridOn}"/>
            <Button Style="{StaticResource Chip}" Content="Vignette" Command="{Binding toggleVignette}" Tag="{Binding ui.vignetteOn}"/>
            <Button Style="{StaticResource Chip}" Content="CRT" Command="{Binding toggleCrt}" Tag="{Binding ui.crtOn}"/>
            <!-- SHADER-FX SLOT C: "Shader FX" chip goes here -->
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Style="{StaticResource SmallBtn}" Command="{Binding bloomDown}"><Path Style="{StaticResource Icon}" Data="M6,12 L18,12"/></Button>
            <TextBlock Text="{Binding ui.bloomLabel}" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" Foreground="{Binding theme.text}"/>
            <Button Style="{StaticResource SmallBtn}" Command="{Binding bloomUp}"><Path Style="{StaticResource Icon}" Data="M6,12 L18,12 M12,6 L12,18"/></Button>
          </StackPanel>
        </StackPanel>
      </ContentControl>

      <!-- ~~~~ Bottom dock: canvas + world actions ~~~~ -->
      <ContentControl Style="{StaticResource Panel}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Padding="12,8">
        <ContentControl.RenderTransform>
          <TranslateTransform x:Name="DockT"/>
        </ContentControl.RenderTransform>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ActBtn}" Command="{Binding undo}">
            <StackPanel><Path Style="{StaticResource Icon}" Data="M9,14 L4,9 L9,4 M4,9 L14,9 A6,6 0 0 1 14,21 L10,21"/><TextBlock Style="{StaticResource IconLabel}" Text="Undo"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ActBtn}" Command="{Binding clear}">
            <StackPanel><Path Style="{StaticResource Icon}" Data="M5,7 L19,7 M10,7 L10,4 L14,4 L14,7 M7,7 L8,21 L16,21 L17,7"/><TextBlock Style="{StaticResource IconLabel}" Text="Clear"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ActBtn}" Command="{Binding gravity}">
            <StackPanel><Path Style="{StaticResource Icon}" Data="M12,3 L12,16 M7,11 L12,16 L17,11 M5,21 L19,21"/><TextBlock Style="{StaticResource IconLabel}" Text="Gravity"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ActBtn}" Command="{Binding shake}">
            <StackPanel><Path Style="{StaticResource Icon}" Data="M3,8 L6,12 L3,16 M21,8 L18,12 L21,16 M9,5 L15,5 L15,19 L9,19 Z"/><TextBlock Style="{StaticResource IconLabel}" Text="Shake"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ActBtn}" Command="{Binding explode}">
            <StackPanel><Path Style="{StaticResource Icon}" Data="M12,2 L13.5,8 L19,5 L15.5,10.5 L22,12 L15.5,13.5 L19,19 L13.5,16 L12,22 L10.5,16 L5,19 L8.5,13.5 L2,12 L8.5,10.5 L5,5 L10.5,8 Z"/><TextBlock Style="{StaticResource IconLabel}" Text="Explode"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ActBtn}" Command="{Binding freeze}">
            <StackPanel><Path Style="{StaticResource Icon}" Data="M12,2 L12,22 M3.3,7 L20.7,17 M3.3,17 L20.7,7 M9,4 L12,6 L15,4 M9,20 L12,18 L15,20"/><TextBlock Style="{StaticResource IconLabel}" Text="Freeze"/></StackPanel>
          </Button>

          <Rectangle Width="1.5" Margin="10,8" Fill="{Binding theme.edgeB}"/>

          <Button Style="{StaticResource ActBtn}" Command="{Binding worldDraw}" Tag="{Binding ui.worldOwned}">
            <StackPanel><Path Style="{StaticResource Icon}" Data="M12,3 A9,9 0 1 1 11.99,3 M3,12 L21,12 M12,3 C8,7 8,17 12,21 M12,3 C16,7 16,17 12,21"/><TextBlock Style="{StaticResource IconLabel}" Text="3D Board"/></StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" Visibility="{Binding ui.worldVis}">
            <Button Style="{StaticResource ActBtn}" Command="{Binding worldBeam}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,19 L20,19 M7,22 L17,22"/><TextBlock Style="{StaticResource IconLabel}" Text="Beam"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ActBtn}" Command="{Binding worldDrop}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M8,4 A2,2 0 1 1 7.99,4 M16,8 A2,2 0 1 1 15.99,8 M11,13 A2,2 0 1 1 10.99,13 M4,21 L20,21"/><TextBlock Style="{StaticResource IconLabel}" Text="Drop"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ActBtn}" Command="{Binding worldExplode}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M12,9 A3,3 0 1 1 11.99,9 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9"/><TextBlock Style="{StaticResource IconLabel}" Text="Burst"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ActBtn}" Command="{Binding worldFreeze}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M7,4 L7,20 M17,4 L17,20"/><TextBlock Style="{StaticResource IconLabel}" Text="Hold"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ActBtn}" Command="{Binding worldUndo}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M9,14 L4,9 L9,4 M4,9 L14,9 A6,6 0 0 1 14,21 L10,21"/><TextBlock Style="{StaticResource IconLabel}" Text="Undo 3D"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ActBtn}" Command="{Binding worldClear}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M4,20 L20,4 M8,4 L4,8 M20,16 L16,20"/><TextBlock Style="{StaticResource IconLabel}" Text="Wipe 3D"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ActBtn}" Command="{Binding worldLeave}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M14,4 L20,4 L20,20 L14,20 M10,8 L6,12 L10,16 M6,12 L16,12"/><TextBlock Style="{StaticResource IconLabel}" Text="Leave"/></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </ContentControl>

      <!-- ~~~~ Toast ~~~~ -->
      <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,104,0,0" CornerRadius="18" Padding="18,8"
              Opacity="0" IsHitTestVisible="False" Background="{Binding theme.panelSolid}" BorderThickness="1" BorderBrush="{Binding theme.edgeA}">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect Color="{Binding theme.glow}" ShadowDepth="0" BlurRadius="18" Opacity="0.6"/>
        </Border.Effect>
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ui.toastFlip}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0"/>
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-14" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0"/>
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-14" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding ui.toast}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding theme.text}"/>
      </Border>

      <!-- ~~~~ Theme gallery ~~~~ -->
      <Grid Visibility="{Binding ui.galleryVis}">
        <Button Template="{StaticResource BareButton}" Background="#8C000000" Command="{Binding toggleGallery}"/>
        <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" RenderTransformOrigin="0.5,0.5">
          <ContentControl.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
          </ContentControl.RenderTransform>
          <ContentControl.Style>
            <Style TargetType="ContentControl" BasedOn="{StaticResource Panel}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ui.galleryOpen}" Value="True">
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.85" To="1" Duration="0:0:0.45">
                          <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.85" To="1" Duration="0:0:0.45">
                          <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
          <StackPanel>
            <TextBlock Text="CHOOSE A THEME" FontSize="18" FontWeight="Black" Foreground="{Binding theme.text}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <UniformGrid Columns="5">
              <Button Style="{StaticResource Card}" Command="{Binding setTheme}" CommandParameter="0">
                <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E6EBF3" Offset="0"/><GradientStop Color="#DAE1EC" Offset="1"/></LinearGradientBrush></Grid.Background>
                  <Border Width="70" Height="34" CornerRadius="12" Background="#E3E9F2" Margin="0,0,0,26"><Border.Effect><DropShadowEffect Color="#A3B1C6" ShadowDepth="4" BlurRadius="10" Direction="315"/></Border.Effect></Border>
                  <TextBlock Text="Soft Clay" VerticalAlignment="Bottom" Margin="10,0,0,8" FontWeight="Bold" Foreground="#4A5468"/></Grid>
              </Button>
              <Button Style="{StaticResource Card}" Command="{Binding setTheme}" CommandParameter="1">
                <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2D313B" Offset="0"/><GradientStop Color="#252931" Offset="1"/></LinearGradientBrush></Grid.Background>
