            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="rect" Tag="{Binding sel.rect}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M4,6 L20,6 L20,18 L4,18 Z"/><TextBlock Style="{StaticResource IconLabel}" Text="Rect"/></StackPanel>
