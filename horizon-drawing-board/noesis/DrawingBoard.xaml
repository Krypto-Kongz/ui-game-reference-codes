                <Grid><Grid.Background><RadialGradientBrush><GradientStop Color="#FF6A00" Offset="0"/><GradientStop Color="#3D0C02" Offset="0.7"/><GradientStop Color="#120200" Offset="1"/></RadialGradientBrush></Grid.Background>
