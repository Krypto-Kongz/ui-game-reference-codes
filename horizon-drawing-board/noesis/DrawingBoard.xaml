            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="marker" Tag="{Binding sel.marker}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M6,20 L10,8 L14,8 L18,20 M10,8 L11,3 L13,3 L14,8 M4,22 L20,22"/><TextBlock Style="{StaticResource IconLabel}" Text="Marker"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="neon" Tag="{Binding sel.neon}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M5,19 L7,17 M17,7 L19,5 M12,8 A4,4 0 1 1 11.99,8"/><TextBlock Style="{StaticResource IconLabel}" Text="Neon"/></StackPanel>
            </Button>
