              </Button>
              <Button Style="{StaticResource Card}" Command="{Binding setTheme}" CommandParameter="2">
                <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B1D6E" Offset="0"/><GradientStop Color="#FF5FD2" Offset="0.55"/><GradientStop Color="#0E5A7A" Offset="1"/></LinearGradientBrush></Grid.Background>
                  <Border Width="70" Height="34" CornerRadius="12" Background="#40FFFFFF" BorderBrush="#B3FFFFFF" BorderThickness="1" Margin="0,0,0,26"/>
                  <TextBlock Text="Frosted Aurora" VerticalAlignment="Bottom" Margin="10,0,0,8" FontWeight="Bold" Foreground="#FFFFFF"/></Grid>
              </Button>
              <Button Style="{StaticResource Card}" Command="{Binding setTheme}" CommandParameter="3">
                <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A78BFA" Offset="0"/><GradientStop Color="#E3F2FF" Offset="0.5"/><GradientStop Color="#F472B6" Offset="1"/></LinearGradientBrush></Grid.Background>
