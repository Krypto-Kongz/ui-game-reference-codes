              <StackPanel><Path Style="{StaticResource Icon}" Data="M3,19 A9,9 0 0 1 21,19 M7,19 A5,5 0 0 1 17,19 M11,19 A1,1 0 0 1 13,19"/><TextBlock Style="{StaticResource IconLabel}" Text="RGB"/></StackPanel>
