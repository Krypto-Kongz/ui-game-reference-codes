            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="aurora" Tag="{Binding sel.aurora}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M3,20 C6,8 9,8 12,14 S18,6 21,4 M3,20 L21,20 M6,20 C8,13 10,13 12,17"/><TextBlock Style="{StaticResource IconLabel}" Text="Aurora"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="pulse" Tag="{Binding sel.pulse}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M2,12 L7,12 L9,6 L12,18 L15,9 L17,12 L22,12"/><TextBlock Style="{StaticResource IconLabel}" Text="Pulse"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="spray" Tag="{Binding sel.spray}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M7,11 L15,11 L15,22 L7,22 Z M9,11 L9,7 L13,7 L13,11 M18,5 L18.1,5 M21,8 L21.1,8 M21,3 L21.1,3 M18,9 L18.1,9"/><TextBlock Style="{StaticResource IconLabel}" Text="Spray"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="sparkle" Tag="{Binding sel.sparkle}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M12,2 L14,10 L22,12 L14,14 L12,22 L10,14 L2,12 L10,10 Z"/><TextBlock Style="{StaticResource IconLabel}" Text="Stardust"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="physics" Tag="{Binding sel.physics}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M12,3 A4,4 0 1 1 11.99,3 M12,13 L12,16 M8,14 L8,15 M16,14 L16,15 M4,21 L20,21"/><TextBlock Style="{StaticResource IconLabel}" Text="Physics"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="line" Tag="{Binding sel.line}">
