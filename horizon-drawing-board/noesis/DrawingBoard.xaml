              </Button>
              <Button Style="{StaticResource Card}" Command="{Binding setTheme}" CommandParameter="11">
                <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFE9F4" Offset="0"/><GradientStop Color="#E4F0FF" Offset="1"/></LinearGradientBrush></Grid.Background>
