              <StackPanel><Path Style="{StaticResource Icon}" Data="M3,17 L13,7 L20,14 L14,20 L6,20 Z M8,12 L15,19"/><TextBlock Style="{StaticResource IconLabel}" Text="Eraser"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Command="{Binding setTool}" CommandParameter="hand" Tag="{Binding sel.hand}">
              <StackPanel><Path Style="{StaticResource Icon}" Data="M8,13 L8,5 A1.5,1.5 0 0 1 11,5 L11,11 L11,4 A1.5,1.5 0 0 1 14,4 L14,11 L14,5 A1.5,1.5 0 0 1 17,5 L17,14 C17,19 14,21 11,21 C8,21 6,19 5,16 L4,13 A1.5,1.5 0 0 1 7,12 Z"/><TextBlock Style="{StaticResource IconLabel}" Text="Grab"/></StackPanel>
