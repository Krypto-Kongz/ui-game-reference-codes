<!--
  ShaderFX.snippets.xaml  -  optional Noesis shader add-on for DrawingBoard.xaml

  This is NOT a page. It holds paste-in blocks for Noesis's shader brushes and shader effects
  (PlasmaBrushShader, WavesBrushShader, ConicGradientBrushShader, PixelateEffect, ChromaticAberrationEffect,
  PinchEffect, NoiseEffect, SaturationEffect). They are kept out of the main page on purpose:
  if your Horizon build's Noesis Studio does not ship one of these classes, a single unknown
  type would stop the whole page from loading. Add them one at a time and test.

  HOW TO USE
    1. Add the xmlns line below to the <UserControl> tag of DrawingBoard.xaml. In Noesis
       Studio, check the namespace the shader classes appear under (Assets / toolbox) and
       adjust the prefix mapping if it differs.
    2. Paste each block at the matching "SHADER-FX SLOT" comment in DrawingBoard.xaml.
    3. DrawingBoardUI.ts already drives every bound value here (ui.pixelSize, ui.chroma,
       ui.pinch, ui.pinchX/Y, ui.saturation, ui.noise) through the "Shader FX" chip, which
       cycles: Off > Pixel Art > Glitch > Bulge (follows the cursor) > Noir > Dream.
    4. Property names follow the Noesis App.Shaders reference. If Studio's property panel
       shows a different name for a property, rename it here.
-->
<Snippets
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:fx="clr-namespace:NoesisApp;assembly=Noesis.App">

  <!-- ======================================================================================= -->
  <!-- STEP 1: namespace lines to add to the <UserControl ...> tag                              -->
  <!--   xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"        -->
  <!--   xmlns:fx="clr-namespace:NoesisApp;assembly=Noesis.App"                                 -->
  <!-- ======================================================================================= -->


  <!-- ======================================================================================= -->
  <!-- SLOT A: animated shader backgrounds (inside the blob Grid, after the three Ellipses)     -->
  <!-- A plasma field that slowly breathes behind glass panels, and an overlay of soft waves.   -->
  <!-- ======================================================================================= -->
  <SlotA>
    <Rectangle x:Name="PlasmaBg" Opacity="0.35" IsHitTestVisible="False">
      <Rectangle.Fill>
        <SolidColorBrush Color="White">
          <noesis:Brush.Shader>
            <!-- also exposes Size, Scale, Bias, Frequency, Phase (per-RGB factors) to tune the palette -->
            <fx:PlasmaBrushShader x:Name="Plasma"/>
          </noesis:Brush.Shader>
        </SolidColorBrush>
      </Rectangle.Fill>
      <Rectangle.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Plasma" Storyboard.TargetProperty="Time"
                               From="0" To="100" Duration="0:1:40" RepeatBehavior="Forever"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Rectangle.Triggers>
    </Rectangle>

    <Rectangle Opacity="0.25" IsHitTestVisible="False">
      <Rectangle.Fill>
        <SolidColorBrush Color="White">
          <noesis:Brush.Shader>
            <fx:WavesBrushShader x:Name="Waves"/>
          </noesis:Brush.Shader>
        </SolidColorBrush>
      </Rectangle.Fill>
      <Rectangle.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Waves" Storyboard.TargetProperty="Time"
                               From="0" To="60" Duration="0:1:0" RepeatBehavior="Forever"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Rectangle.Triggers>
    </Rectangle>
  </SlotA>


  <!-- ======================================================================================= -->
  <!-- SLOT B: wrap the canvas in shader effects.                                               -->
  <!-- An element can carry only one Effect, so each effect gets its own wrapper Grid.          -->
  <!-- In DrawingBoard.xaml, replace                                                           -->
  <!--      <Grid x:Name="CanvasHost">  ...  </Grid>                                            -->
  <!-- with the nesting below (keep CanvasHost and everything inside it unchanged).             -->
  <!-- ======================================================================================= -->
  <SlotB>
    <Grid x:Name="FxNoise">
      <Grid.Effect>
        <fx:NoiseEffect Amount="{Binding ui.noise}"/>
      </Grid.Effect>
      <Grid x:Name="FxSaturation">
        <Grid.Effect>
          <fx:SaturationEffect Saturation="{Binding ui.saturation}"/>
        </Grid.Effect>
        <Grid x:Name="FxChroma">
          <Grid.Effect>
            <fx:ChromaticAberrationEffect Amount="{Binding ui.chroma}"/>
          </Grid.Effect>
          <Grid x:Name="FxPinch">
            <Grid.Effect>
              <fx:PinchEffect CenterX="{Binding ui.pinchX}" CenterY="{Binding ui.pinchY}" Radius="0.18" Amount="{Binding ui.pinch}"/>
            </Grid.Effect>
            <Grid x:Name="FxPixel">
              <Grid.Effect>
                <fx:PixelateEffect Size="{Binding ui.pixelSize}"/>
              </Grid.Effect>

              <!-- ===== the original <Grid x:Name="CanvasHost"> ... </Grid> goes here ===== -->

            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </SlotB>


  <!-- ======================================================================================= -->
  <!-- SLOT C: the "Shader FX" chip. Paste inside the EFFECTS WrapPanel of the right panel.     -->
  <!-- ======================================================================================= -->
  <SlotC>
    <Button Style="{StaticResource Chip}" Content="{Binding ui.fxName}" Command="{Binding cycleShaderFx}" Tag="{Binding ui.fxOn}"/>
  </SlotC>


  <!-- ======================================================================================= -->
  <!-- SLOT D (optional): conic rainbow ring around the current-color orb.                      -->
  <!-- Replace the Ellipse that uses ColorRingSpin (right panel) with this one.                 -->
  <!-- ======================================================================================= -->
  <SlotD>
    <Ellipse StrokeThickness="4">
      <Ellipse.Stroke>
        <SolidColorBrush Color="White">
          <noesis:Brush.Shader>
            <fx:ConicGradientBrushShader/>
          </noesis:Brush.Shader>
        </SolidColorBrush>
      </Ellipse.Stroke>
    </Ellipse>
  </SlotD>

</Snippets>
